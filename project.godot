; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Stock RPG"
config/description="개미 군단의 투자 여정 (MTS 방치형 모바일 RPG)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.065, 0.12, 1)
boot_splash/image="res://assets/branding/splash.png"
config/icon="res://assets/branding/icon.png"

[autoload]

Global="*res://scripts/global.gd"
SoundManager="*res://scripts/sound_manager.gd"
LeaderboardManager="*res://scripts/leaderboard_manager.gd"
MarketDataManager="*res://scripts/market_data_manager.gd"
PortfolioManager="*res://scripts/portfolio_manager.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=2400
window/size/window_width_override=540
window/size/window_height_override=1200
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input]

